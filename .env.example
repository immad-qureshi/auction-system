HTTP_SERVER=:8080

#Generate with: openssl rand -base64 32 (the app requires atleast 32 bytes)
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes

POSTGRES_USER=admin
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=auctionapi

#User, password and database name must match the three POSTGRES values above
#For local development use simple letters and numbers for the password as it goes into the url and special characters (@, :, /, #, ?,%) have meaning in the url and can break it.
DATABASE_URL=postgres://admin:change_this_password@localhost:5433/auctionapi?sslmode=disable